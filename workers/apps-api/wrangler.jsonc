    "COGNITO_USER_POOL_ID": "ap-northeast-1_CqkNv5buN",
    "COGNITO_USER_POOL_CLIENT_ID": "6lp8qk50nnuf5n4a8u71dl9idi",
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hundred-apps-prod",
      "database_id": "cecee6f9-06fa-4c36-9e34-a9b1d8a17130"
    }
  ]
