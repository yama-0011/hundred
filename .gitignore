lerna-debug.log*

# Frontend (Node.js / Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/**/*.local
# Unity WebGL成果物はCloudflare Pages配信用として
# frontend/public/anigram-unity/へ同期し、Gitで管理する。
# 旧・未圧縮ビルドとFinder由来の重複ファイルは配信しない。
frontend/public/anigram-unity/Build/WebGL.data
frontend/public/anigram-unity/Build/WebGL.framework.js
frontend/public/anigram-unity/Build/WebGL.wasm
frontend/public/anigram-unity/index 2.html

# Cloudflare Workers
workers/**/node_modules/
workers/**/.wrangler/
workers/**/.dev.vars

