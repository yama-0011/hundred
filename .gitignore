# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend (Node.js / Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/**/*.local

# Cloudflare Workers
workers/**/node_modules/
workers/**/.wrangler/
workers/**/.dev.vars

# Backend (Java / Maven)
*.class
*.jar
*.war
*.nar
*.ear
backend/target/
backend/build/
backend/HELP.md
backend/.mvn/wrapper/maven-wrapper.jar

# Java process files
hs_err_pid*
replay_pid*

# Java IDEs and build tools
.mtj.tmp/
*.ctxt
.idea/
*.iws
*.iml
*.ipr
backend/.apt_generated/
backend/.classpath
backend/.factorypath
backend/.project
backend/.settings/
backend/.springBeans
backend/.sts4-cache/
backend/nbproject/private/
backend/nbbuild/
backend/nbdist/
backend/.nb-gradle/

# Visual Studio / OS files
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# VS Code
# ルートの .vscode/settings.json はチーム共通設定として管理する。
frontend/.vscode/*
!frontend/.vscode/extensions.json
backend/.vscode/

# Archives
*.zip
*.tar.gz
*.rar
